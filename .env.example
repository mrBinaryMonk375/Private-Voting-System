# Private Voting System — Environment Variables
#
# Copy this file to .env.local for local development.
# For production deployments (Vercel / Netlify), set these as environment variables.

# Midnight network to connect to (preprod | preview | standalone)
VITE_NETWORK_ID=preprod

# Logging verbosity (trace | debug | info | warn | error)
VITE_LOGGING_LEVEL=info

# The deployed contract address — replace after deployment
# After running: NODE_OPTIONS="--max-old-space-size=12288" npm run deploy -- --network preprod
# Copy the printed contract address and paste it here:
VITE_CONTRACT_ADDRESS=<YOUR_DEPLOYED_CONTRACT_ADDRESS>
